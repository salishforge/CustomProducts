# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_DIRECT_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth (WorkOS AuthKit) ---
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=  # 32+ random characters; openssl rand -base64 24
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@salishforge.com

# --- AI (Replicate) ---
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=
REPLICATE_MODEL_T2I=black-forest-labs/flux-schnell
REPLICATE_MODEL_T2I_PRO=black-forest-labs/flux-1.1-pro
REPLICATE_MODEL_I2I=black-forest-labs/flux-redux-dev
REPLICATE_MODEL_UPSCALE=nightmareai/real-esrgan
REPLICATE_MODEL_DEPTH=intel-isl/midas
AI_DAILY_COST_CEILING_USD_CENTS=2000

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_UPLOADS=salishforge-uploads
R2_BUCKET_GENERATIONS=salishforge-generations
R2_BUCKET_PRINT=salishforge-print
R2_PUBLIC_DOMAIN=

# --- Cloudflare Images ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_DELIVERY_DOMAIN=

# --- Jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Moderation (OpenAI) ---
OPENAI_API_KEY=

# --- Design Console (Anthropic) ---
# Curator LLM for /admin/design. Console is disabled unless this is set AND the
# ceiling below is > 0. Spend is metered per UTC day in site_settings.
ANTHROPIC_API_KEY=
DESIGN_CONSOLE_MODEL=claude-sonnet-4-6
DESIGN_CONSOLE_DAILY_COST_CEILING_USD_CENTS=200

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
