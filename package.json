{
  "name": "salishforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --tsconfig tsconfig.json --env-file=.env.local lib/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "inngest:dev": "inngest-cli dev -u http://localhost:3000/api/inngest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@imgly/background-removal": "^1.7.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@workos-inc/authkit-nextjs": "^2.10.0",
    "@workos-inc/node": "^7.71.0",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.0.0",
    "immer": "^10.1.1",
    "inngest": "^3.32.0",
    "konva": "^9.3.20",
    "lenis": "^1.1.20",
    "motion": "^12.0.0",
    "next": "^15.5.24",
    "pdf-lib": "^1.17.1",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.2.4",
    "replicate": "^1.0.1",
    "resend": "^4.0.1",
    "sharp": "^0.35.4",
    "stripe": "^17.4.0",
    "three": "^0.171.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.171.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-zod": "^0.8.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0-beta.7",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "comment": "Security overrides for transitive deps. Same-major, backward-compatible bumps to patched versions. Selectors carry the vulnerable range so an override stops applying once a dependency ships a patched version on its own. brace-expansion is pinned per major line because 1.x and 5.x are both in the tree via different minimatch versions. esbuild is intentionally NOT overridden: its advisories are dev-only (Windows file-read, dev-server SSRF never served) and forcing it risks tsx, which runs the test suite.",
    "overrides": {
      "cookie@<0.7.0": "^0.7.2",
      "qs@<6.16.0": "^6.16.0",
      "protobufjs@<=7.6.2": "^7.6.3",
      "postcss@<8.5.18": "^8.5.18",
      "js-yaml@<4.3.2": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "@opentelemetry/propagator-jaeger@<2.9.0": "^2.9.0"
    }
  }
}
